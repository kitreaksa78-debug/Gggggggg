# Nexus Video Downloader Environment Configuration
# Copy this file to .env and configure provider credentials

# Server Port (Default: 3000)
PORT=3000

# Download Provider Configuration
# Set to 'real' to enable real external provider integration
DOWNLOAD_PROVIDER=real

# Real Provider API Endpoint
# Default legitimate provider: Cobalt Media Processing API (v10 / v7) or RapidAPI Social Video API
# For Cobalt: "https://api.cobalt.tools" or your private/self-hosted instance endpoint (e.g. "https://cobalt.yourdomain.com")
# For RapidAPI: "https://social-download-all-in-one.p.rapidapi.com" or "https://snap-save.p.rapidapi.com"
DOWNLOAD_PROVIDER_API_URL=https://api.cobalt.tools

# Real Provider API Key (Required for authenticated Cobalt instances or RapidAPI)
# Leave empty only if using a public unauthenticated instance that does not require an API key
DOWNLOAD_PROVIDER_API_KEY=

# Provider Flavor: 'cobalt' | 'rapidapi' | 'auto' (Default: 'auto')
DOWNLOAD_PROVIDER_FLAVOR=auto

# Optional: CORS Allowed Origins (comma-separated, leave blank for same-origin dev/production)
CORS_ORIGIN=

# Optional: Gemini API Key (automatically injected by AI Studio if enabled)
GEMINI_API_KEY=

# Optional: Public App URL
APP_URL=
